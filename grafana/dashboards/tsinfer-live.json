{
  "__inputs": [],
  "title": "tsinfer 실시간 — 교육장 공기질과 추론 결과",
  "uid": "tsinfer-live",
  "description": "AIP 3.2 시계열 추론 과제. 센서 원본(iot-bucket)과 서비스 추론 결과(tsinfer)를 한 화면에서 본다.",
  "tags": [
    "tsinfer",
    "jetson",
    "aip-3.2"
  ],
  "timezone": "Asia/Seoul",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "1m",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-12h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "30s",
      "1m",
      "5m",
      "15m"
    ]
  },
  "links": [
    {
      "title": "저장소",
      "type": "link",
      "url": "https://github.com/AIP-1-3/jenson_AIGJ_01_002",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "ds",
        "label": "InfluxDB",
        "type": "datasource",
        "query": "influxdb",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": ""
      },
      {
        "name": "bucket",
        "label": "센서 버킷",
        "type": "textbox",
        "query": "iot-bucket",
        "current": {
          "text": "iot-bucket",
          "value": "iot-bucket"
        },
        "hide": 0
      },
      {
        "name": "result_bucket",
        "label": "결과 버킷",
        "type": "textbox",
        "query": "tsinfer",
        "current": {
          "text": "tsinfer",
          "value": "tsinfer"
        },
        "hide": 0
      },
      {
        "name": "space",
        "label": "공간",
        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "${ds}"
        },
        "definition": "schema.tagValues location",
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"${bucket}\", tag: \"location\", predicate: (r) => r._measurement == \"co2\" or r._measurement == \"temperature\", start: -7d)",
        "multi": true,
        "includeAll": true,
        "refresh": 1,
        "sort": 1,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "hide": 0
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "id": 1,
      "title": "실시간 센서 — MQTT → InfluxDB ${bucket}",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      }
    },
    {
      "type": "stat",
      "id": 2,
      "title": "현재 CO₂ (최근 30분 마지막 값, 공간 평균)",
      "description": "1,000ppm 환기 권장(주황), 1,500ppm 위험(빨강). configs/default.yaml thresholds 와 같다.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 5,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -30m)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"value\" and contains(value: r.location, set: ${space:json}))\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> group(columns: [\"location\", \"device_id\"])\n  |> last()\n  |> group(columns: [\"location\"])\n  |> mean()"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ppm",
          "displayName": "${__field.labels.location}",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value_and_name",
        "justifyMode": "auto",
        "orientation": "horizontal"
      }
    },
