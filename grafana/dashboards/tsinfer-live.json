          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"value\" and contains(value: r.location, set: ${space:json}))\n  |> map(fn: (r) => ({r with _value: float(v: r._value)}))\n  |> group(columns: [\"location\"])\n  |> aggregateWindow(every: v.windowPeriod, fn: mean, createEmpty: false)"
        }
