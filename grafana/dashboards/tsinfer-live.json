    {
      "type": "table",
      "id": 8,
      "title": "센서별 마지막 수신 (오래된 순)",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "description": "minutes_ago 가 10분을 넘으면 서비스가 data_gap 경보를 낸다 (docs/interface.md).",
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${bucket}\")\n  |> range(start: -24h)\n  |> filter(fn: (r) => (r._measurement == \"co2\" or r._measurement == \"temperature\" or r._measurement == \"humidity\") and r._field == \"value\" and contains(value: r.location, set: ${space:json}))\n  |> group(columns: [\"location\", \"device_id\", \"_measurement\"])\n  |> last()\n  |> map(fn: (r) => ({location: r.location, device_id: r.device_id, metric: r._measurement, value: float(v: r._value), last_seen: r._time,\n      minutes_ago: float(v: int(v: now()) - int(v: r._time)) / 60000000000.0}))\n  |> group()\n  |> sort(columns: [\"minutes_ago\"], desc: true)"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "minutes_ago"
            },
            "properties": [
              {
                "id": "unit",
                "value": "m"
              },
              {
                "id": "decimals",
                "value": 1
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 10
                    },
                    {
                      "color": "red",
                      "value": 60
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "value"
            },
            "properties": [
              {
                "id": "decimals",
                "value": 1
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
