    {
      "type": "timeseries",
      "id": 11,
      "title": "${space}: 실제 CO₂ vs 30·60분 전에 한 예측",
      "description": "예측점은 예측이 가리키는 시각(만든 시각 + 30·60분)에 찍었다. 실제선과 겹칠수록 정확하다.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 8,
        "x": 0,
        "y": 33
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "actual = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"value\" and r.location == \"${space}\")\n  |> map(fn: (r) => ({r with _value: float(v: r._value), space: r.location}))\n  |> group(columns: [\"space\"])\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\nactual\n  |> set(key: \"series\", value: \"실제\")\n  |> group(columns: [\"series\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "from(bucket: \"${result_bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tsinfer_forecast\" and r._field == \"co2\" and r.space == \"${space}\")\n  |> filter(fn: (r) => r.horizon == \"30\" or r.horizon == \"60\")\n  |> group(columns: [\"horizon\"])\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\n  |> map(fn: (r) => ({r with series: r.horizon + \"분 전 예측\"}))\n  |> group(columns: [\"series\"])"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "suffix: ppm",
          "displayName": "${__field.labels.series}",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": 600000,
            "showPoints": "never",
            "pointSize": 4,
            "thresholdsStyle": {
              "mode": "dashed"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1000
              },
              {
                "color": "red",
                "value": 1500
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "showLegend": true,
          "displayMode": "list",
          "placement": "bottom",
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "none"
        }
      },
      "repeat": "space",
      "repeatDirection": "h",
      "maxPerRow": 3
    },
    {
      "type": "timeseries",
      "id": 12,
      "title": "60분 CO₂ 예측 오차 |실제−예측| — 범례 mean = 선택 구간 MAE",
      "description": "과제 3 과 같은 비교를 실시간으로 한다: 서비스 모델 vs 60분 전 값을 그대로 쓴 '현재값 유지'. 5분 평균끼리 비교.",
      "datasource": {
        "type": "influxdb",
        "uid": "${ds}"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 42
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "import \"math\"\nactual = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"value\" and contains(value: r.location, set: ${space:json}))\n  |> map(fn: (r) => ({r with _value: float(v: r._value), space: r.location}))\n  |> group(columns: [\"space\"])\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\npred = from(bucket: \"${result_bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"tsinfer_forecast\" and r._field == \"co2\" and r.horizon == \"60\" and contains(value: r.space, set: ${space:json}))\n  |> group(columns: [\"space\"])\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\njoin(tables: {a: actual, b: pred}, on: [\"_time\", \"space\"])\n  |> map(fn: (r) => ({_time: r._time, _start: r._start_a, _stop: r._stop_a, space: r.space, _value: math.abs(x: r._value_a - r._value_b)}))\n  |> set(key: \"method\", value: \"서비스 모델\")\n  |> group(columns: [\"space\", \"method\"])"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "influxdb",
            "uid": "${ds}"
          },
          "query": "import \"math\"\nactual = from(bucket: \"${bucket}\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"co2\" and r._field == \"value\" and contains(value: r.location, set: ${space:json}))\n  |> map(fn: (r) => ({r with _value: float(v: r._value), space: r.location}))\n  |> group(columns: [\"space\"])\n  |> aggregateWindow(every: 5m, fn: mean, createEmpty: false)\npast = actual |> timeShift(duration: 60m)\njoin(tables: {a: actual, b: past}, on: [\"_time\", \"space\"])\n  |> map(fn: (r) => ({_time: r._time, _start: r._start_a, _stop: r._stop_a, space: r.space, _value: math.abs(x: r._value_a - r._value_b)}))\n  |> set(key: \"method\", value: \"현재값 유지\")\n  |> group(columns: [\"space\", \"method\"])"
        }
      ],
