# 사용자 서비스 — 보드 재부팅 뒤 자동 시작 (과제 1-3, 8-4)
# 설치:
#   mkdir -p ~/.config/systemd/user
#   cp deploy/systemd/tsinfer-collector.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now tsinfer-collector
# 로그인하지 않아도 부팅 시 돌게 하려면 관리자가 한 번: sudo loginctl enable-linger <계정>
# 저장소 위치가 ~/jenson_AIGJ_01_002 가 아니면 아래 경로를 고친다.

[Unit]
Description=tsinfer MQTT collector
After=network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=%h/jenson_AIGJ_01_002
Environment=PYTHONPATH=%h/jenson_AIGJ_01_002/src
ExecStart=%h/jenson_AIGJ_01_002/.venv/bin/python -m tsinfer.collector
Restart=always
RestartSec=5
# 공용 장비 보호: 수집기는 가볍게. 넘으면 이 프로세스만 재시작된다.
MemoryMax=300M

[Install]
WantedBy=default.target
