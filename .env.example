# 복사해서 쓴다: cp .env.example .env && chmod 600 .env
# 값은 과제 이슈(curriculum#6)에서 확인. 이 파일에는 값을 채우지 않는다.

MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# 사람마다 반드시 다르게. 같은 ID 로 두 명이 붙으면 브로커가 먼저 붙은 쪽을 끊는다.
MQTT_CLIENT_ID=tsinfer-<이름>-collector

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=
# Grafana 용 추론 결과를 쓸 서버 (비우면 INFLUX_URL·INFLUX_ORG). 학교 서버 예: http://influx.java21.net / iot-lab
INFLUX_RESULT_URL=
INFLUX_RESULT_ORG=
# Grafana 용 추론 결과 버킷 (python -m tsinfer.bridge 가 쓴다). 원본 iot-bucket 과 달라야 한다.
INFLUX_RESULT_BUCKET=tsinfer
# 결과 버킷에 쓰기 권한이 있는 토큰. 비우면 INFLUX_TOKEN 을 쓴다.
INFLUX_WRITE_TOKEN=

# 내 Jetson 포트 대역 안에서 고른다 (aip-1-3: 8100~8199)
API_PORT=8100

# 로컬 저장소 (SQLite, WAL 모드)
DB_PATH=data/tsinfer.db

# 서비스 결과 발행 토픽 접두사 (공용 브로커라 반드시 본인 이름으로). 비우면 발행하지 않는다.
PUBLISH_PREFIX=tsinfer/<이름>

# 서비스 예측 모델: trend(기준선, 기본) | gru(과제 3, models/forecast_gru.pt 필요) | persistence
SERVICE_MODEL=trend

# Jetson 에 Grafana 를 직접 띄울 때만 (grafana/docker-compose.yml). 내 포트 대역 안에서.
GRAFANA_PORT=8130
GRAFANA_ADMIN_PASSWORD=
# Grafana 가 InfluxDB 를 읽을 토큰 (센서 버킷 읽기 + 결과 버킷 읽기)
GRAFANA_INFLUX_TOKEN=
# Grafana 알림을 받을 디스코드 채널 웹훅 (채널 설정 → 연동 → 웹후크). 주소 자체가 비밀번호라 여기에만 둔다.
DISCORD_WEBHOOK_URL=
