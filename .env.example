# 복사해서 쓴다: cp .env.example .env && chmod 600 .env
# 값은 과제 이슈(curriculum#6)에서 확인. 이 파일에는 값을 채우지 않는다.

MQTT_HOST=
MQTT_PORT=1883
MQTT_USER=
MQTT_PASS=
# 사람마다 반드시 다르게. 같은 ID 로 두 명이 붙으면 브로커가 먼저 붙은 쪽을 끊는다.
MQTT_CLIENT_ID=tsinfer-<이름>-collector

INFLUX_URL=
INFLUX_TOKEN=
INFLUX_ORG=
INFLUX_BUCKET=

# 내 Jetson 포트 대역 안에서 고른다 (aip-1-3: 8100~8199)
API_PORT=8100

# 로컬 저장소 (SQLite, WAL 모드)
DB_PATH=data/tsinfer.db
